# Copy this file to `.env` and adjust as needed.
# docker compose reads this automatically from the repo root.

# --- Postgres (service: db) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=transaction_parser
POSTGRES_PORT=55432

# --- Backend (service: backend) ---
# Must match the Postgres settings above; "db" is the compose service name.
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/transaction_parser
APP_ENV=development
LOG_LEVEL=INFO
BACKEND_PORT=58000

# --- Frontend (service: frontend) — added in Phase 5 ---
FRONTEND_PORT=5173
